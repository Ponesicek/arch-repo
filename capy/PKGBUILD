# Repackages the official Capy .deb from https://capy.ai/download.
# Written for this repo (no AUR base); update.sh bumps pkgver and checksums.

pkgname=capy
pkgver=0.10.0
pkgrel=1
pkgdesc='Capy desktop app: run coding agents in the cloud'
arch=('x86_64')
url='https://capy.ai'
# The .deb declares "License: unknown"; Capy is proprietary.
license=('LicenseRef-Capy')
depends=(
  alsa-lib
  at-spi2-core
  gtk3
  libnotify
  libsecret
  libxss
  libxtst
  mesa
  nss
  util-linux-libs
  xdg-utils
)
optdepends=('libappindicator-gtk3: tray icon')
options=('!strip' '!debug')
source=("https://downloads.capy.ai/stable/capy-${pkgver}-amd64.deb")
noextract=("capy-${pkgver}-amd64.deb")
b2sums=('c88a71a2f2c2b59cf0a1bf14e1e26cde979af13ac3cce8e309c4e2697e4e4f0899ef24cc9e2aa823a5eb6dda0d98c76fd8cbc5afa1e8b7fd66cf3b340fcd0a1b')

prepare() {
  rm -rf deb
  mkdir deb
  bsdtar -xOf "capy-${pkgver}-amd64.deb" 'data.tar.*' | bsdtar -xf - -C deb
}

package() {
  cp -a deb/opt deb/usr "${pkgdir}/"

  # resources/package-type tells Capy's updater it was installed from a .deb,
  # so it would try to install .deb updates itself. Without the file Capy
  # treats the install as externally managed and turns its updater off.
  rm "${pkgdir}/opt/Capy/resources/package-type"

  # Upstream's postinst creates this symlink; pacman packages ship it instead.
  # Not carried over from postinst: the chrome-sandbox setuid bit (Arch kernels
  # allow unprivileged user namespaces) and the AppArmor profile (Arch doesn't
  # enable AppArmor by default, and the profile is unconfined anyway).
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/Capy/capy "${pkgdir}/usr/bin/capy"
}
