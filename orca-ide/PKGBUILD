# Repackages the official Orca .deb from https://github.com/stablyai/orca/releases.
# Written for this repo (no AUR base); update.sh bumps pkgver and checksums.

pkgname=orca-ide
pkgver=1.4.265
pkgrel=1
pkgdesc='Orca agent development environment: run coding agents in parallel git worktrees'
arch=('x86_64')
url='https://github.com/stablyai/orca'
license=('MIT')
depends=(
  alsa-lib
  at-spi2-core
  gtk3
  libnotify
  libsecret
  libxss
  libxtst
  mesa
  nss
  util-linux-libs
  xdg-utils
)
optdepends=(
  'python: notebook kernels and computer use'
  'python-gobject: computer use'
  'xdotool: computer use on X11'
  'xclip: computer use clipboard on X11'
  'xorg-server-xvfb: headless computer use'
  'libappindicator-gtk3: tray icon'
)
# extra/orca is GNOME's screen reader, which is why upstream calls this orca-ide.
options=('!strip' '!debug')
source=("https://github.com/stablyai/orca/releases/download/v${pkgver}/orca-ide_${pkgver}_amd64.deb"
        "orca-ide-LICENSE-${pkgver}::https://raw.githubusercontent.com/stablyai/orca/v${pkgver}/LICENSE")
noextract=("orca-ide_${pkgver}_amd64.deb")
b2sums=('ac6e4d052f13f44f87b08ea768601b53c22912638da9f53b373d70bf858b1dad9f4b6f5d2f87607729bbcf3c0938215705f63d2de2b8e69ca62ec96ab5c4e047'
        'fdce4a5f4313d37ca3f4a68dc9c31a242cd7f0fb7eae5a9764b9ca79b9316d328d2374154443338f9addc9134490c95fd1973c79c307d5f228f0f37dd6e3fa45')

prepare() {
  mkdir -p deb
  bsdtar -xOf "orca-ide_${pkgver}_amd64.deb" 'data.tar.*' | bsdtar -xf - -C deb
}

package() {
  cp -a deb/opt deb/usr "${pkgdir}/"

  # Upstream's postinst creates this symlink; pacman packages ship it instead.
  # The chrome-sandbox setuid bit from postinst is not needed: Arch kernels
  # allow unprivileged user namespaces.
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/Orca/resources/bin/orca-ide "${pkgdir}/usr/bin/orca-ide"

  install -Dm644 "orca-ide-LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
