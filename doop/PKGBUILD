# Builds the doop desktop app from its release tag at
# https://github.com/doop-design/doop (desktop/src-tauri). Written for this
# repo; the AUR's doop-bin repackages upstream's .deb instead. update.sh bumps
# pkgver and the checksum.
#
# The app is a thin Tauri shell: its window loads https://doop.design, and the
# web app it serves is what you actually use. This package pins the shell
# only; what doop.design serves changes whenever upstream deploys.

pkgname=doop
pkgver=0.15.1
pkgrel=1
pkgdesc='Multiplayer design canvas where humans and AI agents design together (desktop app for doop.design)'
arch=('x86_64')
url='https://doop.design'
license=('AGPL-3.0-only')
depends=('gcc-libs' 'glibc' 'gtk3' 'hicolor-icon-theme' 'webkit2gtk-4.1')
# CI installs only makedepends, and the build links against these.
makedepends=('cargo' 'git' 'gtk3' 'pkgconf' 'webkit2gtk-4.1')
optdepends=('xdg-desktop-portal: native save and open dialogs'
            'claude-code: run doop agent tasks with your local Claude Code')
provides=('doop-bin')
conflicts=('doop-bin')
# makepkg's LTO flags make ring's C objects GCC bitcode, which rust-lld
# cannot link; Cargo's release profile already does LTO for the Rust side.
options=('!lto' '!debug')
source=("git+https://github.com/doop-design/doop.git#tag=desktop-v${pkgver}"
        'doop.desktop')
sha256sums=('9c558f5afa767eaf4ae812ad80a1ebb086a222bf1a596d8676ed2b8dc02695cd'
            'd41b87a522f47221076243d65232fb2bd48c166299d1bb5090931fdb97124ae4')

prepare() {
  cd doop/desktop/src-tauri

  # pacman updates this package, so turn off the shell's own updater. It would
  # otherwise download upstream's .deb from the signed feed at
  # doop.design/desktop/latest.json and try to install it over this one.
  # Every update path (the background check, the menu item, the page's
  # "Restart to update" card) goes through updates_enabled(). The patch must
  # match exactly once, so a release that changes this code fails to build
  # instead of shipping with self-update on.
  local anchor='fn updates_enabled() -> bool {'
  if [[ $(grep -cF -- "$anchor" src/updates.rs) != 1 ]]; then
    echo "updates_enabled() not found exactly once in src/updates.rs" >&2
    return 1
  fi
  sed -i "s/^${anchor}\$/${anchor}\n    return false; \/\/ updated by pacman/" src/updates.rs
  grep -qF 'return false; // updated by pacman' src/updates.rs

  # release-please bumps Cargo.toml's version but not Cargo.lock's, so the
  # tagged lock can still name the previous version for doop-desktop itself.
  # Fix only that entry; --locked then still refuses any other drift.
  sed -i "/^name = \"doop-desktop\"\$/{n;s/^version = .*/version = \"${pkgver}\"/}" Cargo.lock

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd doop/desktop/src-tauri
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # tauri/custom-protocol is what `tauri build` adds for a release build;
  # without it the shell runs in dev mode.
  cargo build --frozen --release --features tauri/custom-protocol
}

package() {
  cd doop/desktop/src-tauri
  install -Dm755 target/release/doop-desktop "${pkgdir}/usr/bin/doop-desktop"
  install -Dm644 "${srcdir}/doop.desktop" "${pkgdir}/usr/share/applications/doop.desktop"
  install -Dm644 icons/32x32.png "${pkgdir}/usr/share/icons/hicolor/32x32/apps/doop-desktop.png"
  install -Dm644 icons/128x128.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/doop-desktop.png"
  install -Dm644 icons/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/doop-desktop.png"
  install -Dm644 ../../LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
